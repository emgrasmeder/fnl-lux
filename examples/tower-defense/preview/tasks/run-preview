#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$DIR"

if ! command -v love >/dev/null 2>&1; then
  echo "run-preview: love not found on PATH" >&2
  exit 2
fi

if [ ! -d ".deps/rocks/fennel" ]; then
  echo "run-preview: run \`deps --lua-version 5.1 --no-prompt\` in examples/tower-defense/preview first" >&2
  exit 2
fi

exec love .
