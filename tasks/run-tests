;; -*- mode: fennel; -*- vi:ft=fennel

(local {: run-tests}
  (require :io.gitlab.andreyorst.fennel-test))
(local discover (require :shared.testing.discover))

(fn select-tests [default-tests]
  (case [(select 1 ((or _G.unpack table.unpack) arg))]
    (where tests (next tests)) tests
    _ default-tests))

(local tests
  [:figuring-it-out :example-coverage-test :all-examples-startup-test :walk-test])

(-> tests
    select-tests
    run-tests)

(each [_ name (ipairs (discover.love2d-example-dirs))]
  (discover.run-example-shell! name
    "deps --profiles dev --no-prompt tasks/run-tests"))
